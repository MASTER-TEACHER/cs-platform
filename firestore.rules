rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------------------------------------------
    // Shared helper functions
    // ------------------------------------------------------------

    function signedIn() {
      return request.auth != null;
    }

    function currentUserId() {
      return request.auth.uid;
    }

    function userProfileExists() {
      return signedIn() &&
        exists(
          /databases/$(database)/documents/users/$(currentUserId())
        );
    }

    function currentUserProfile() {
      return get(
        /databases/$(database)/documents/users/$(currentUserId())
      ).data;
    }

    function isTeacher() {
      return userProfileExists() &&
        (
          currentUserProfile().role == "teacher" ||
          currentUserProfile().role == "admin"
        );
    }

    function isAdmin() {
      return userProfileExists() &&
        currentUserProfile().role == "admin";
    }

    // ------------------------------------------------------------
    // School / tenant helpers
    // ------------------------------------------------------------

    function currentUserHasSchool() {
      return userProfileExists() &&
        ("schoolId" in currentUserProfile()) &&
        currentUserProfile().schoolId is string &&
        currentUserProfile().schoolId != "";
    }

    function currentSchoolId() {
      return currentUserProfile().schoolId;
    }

    function schoolExists(schoolId) {
      return schoolId is string &&
        schoolId != "" &&
        exists(
          /databases/$(database)/documents/schools/$(schoolId)
        );
    }

    function schoolMemberExists(schoolId, userId) {
      return signedIn() &&
        schoolId is string &&
        schoolId != "" &&
        exists(
          /databases/$(database)/documents/schools/$(schoolId)/members/$(userId)
        );
    }

    function schoolMemberData(schoolId, userId) {
      return get(
        /databases/$(database)/documents/schools/$(schoolId)/members/$(userId)
      ).data;
    }

    function isSchoolMember(schoolId) {
      return schoolMemberExists(schoolId, currentUserId()) &&
        schoolMemberData(schoolId, currentUserId()).status == "active";
    }

    function isSchoolAdmin(schoolId) {
      return isAdmin() ||
        (
          isSchoolMember(schoolId) &&
          schoolMemberData(schoolId, currentUserId()).role == "school_admin"
        );
    }

    function isSchoolStaff(schoolId) {
      return isAdmin() ||
        (
          isSchoolMember(schoolId) &&
          schoolMemberData(schoolId, currentUserId()).role in [
            "teacher",
            "school_admin"
          ]
        );
    }

    function sameSchoolUser(userId) {
      return signedIn() &&
        currentUserHasSchool() &&
        exists(
          /databases/$(database)/documents/users/$(userId)
        ) &&
        get(
          /databases/$(database)/documents/users/$(userId)
        ).data.schoolId == currentSchoolId();
    }

    function validAccountType(data) {
      return !("accountType" in data) ||
        data.accountType == "individual" ||
        data.accountType == "school";
    }

    function validPersonalPlan(data) {
      return !("personalPlan" in data) ||
        data.personalPlan == "free" ||
        data.personalPlan == "premium";
    }

    function validEffectivePlan(data) {
      return !("plan" in data) ||
        data.plan == "free" ||
        data.plan == "premium" ||
        data.plan == "school";
    }

    function validSchoolIdField(data) {
      return !("schoolId" in data) ||
        data.schoolId == null ||
        data.schoolId is string;
    }


    // Legacy-safe user account helpers.
    // Missing fields fall back to the values used by older CS Master profiles.
    function userSchoolId(data) {
      return data.get("schoolId", "");
    }

    function userAccountType(data) {
      return data.get("accountType", "individual");
    }

    function userPersonalPlan(data) {
      return data.get("personalPlan", "free");
    }

    function userEffectivePlan(data) {
      return data.get("plan", userPersonalPlan(data));
    }

    function activeMembershipAfter(schoolId, userId) {
      return schoolId is string &&
        schoolId != "" &&
        existsAfter(
          /databases/$(database)/documents/schools/$(schoolId)/members/$(userId)
        ) &&
        getAfter(
          /databases/$(database)/documents/schools/$(schoolId)/members/$(userId)
        ).data.status == "active";
    }

    function validQualification(data) {
      return !("qualification" in data) ||
        data.qualification == null ||
        data.qualification == "GCSE" ||
        data.qualification == "A_LEVEL";
    }

    function validExamBoard(data) {
      return !("examBoard" in data) ||
        data.examBoard == null ||
        data.examBoard == "AQA" ||
        data.examBoard == "OCR" ||
        data.examBoard == "EDEXCEL";
    }

    function validOnboardingStatus(data) {
      return !("onboardingComplete" in data) ||
        data.onboardingComplete is bool;
    }

    function ownsClass(classId) {
      return isTeacher() &&
        exists(
          /databases/$(database)/documents/classes/$(classId)
        ) &&
        get(
          /databases/$(database)/documents/classes/$(classId)
        ).data.teacherId == currentUserId();
    }

    function belongsToClass(classId) {
      return signedIn() &&
        exists(
          /databases/$(database)/documents/classes/$(classId)
        ) &&
        currentUserId() in get(
          /databases/$(database)/documents/classes/$(classId)
        ).data.studentIds;
    }

    function assignmentExists(assignmentId) {
      return exists(
        /databases/$(database)/documents/assignments/$(assignmentId)
      );
    }

    function assignmentData(assignmentId) {
      return get(
        /databases/$(database)/documents/assignments/$(assignmentId)
      ).data;
    }

    function isTeacherForClassAssignment(assignmentId) {
      return signedIn() &&
        exists(
          /databases/$(database)/documents/classAssignments/$(assignmentId)
        ) &&
        (
          get(
            /databases/$(database)/documents/classAssignments/$(assignmentId)
          ).data.teacherId == currentUserId() ||
          isAdmin()
        );
    }

    function isStudentForClassAssignment(assignmentId) {
      return signedIn() &&
        assignmentId is string &&
        exists(
          /databases/$(database)/documents/classAssignments/$(assignmentId)
        ) &&
        currentUserId() in get(
          /databases/$(database)/documents/classAssignments/$(assignmentId)
        ).data.studentIds;
    }


    function examAssignmentExists(assignmentId) {
      return exists(
        /databases/$(database)/documents/examAssignments/$(assignmentId)
      );
    }

    function examAssignmentData(assignmentId) {
      return get(
        /databases/$(database)/documents/examAssignments/$(assignmentId)
      ).data;
    }

    function isStudentForExamAssignment(assignmentId) {
      return signedIn() &&
        examAssignmentExists(assignmentId) &&
        currentUserId() in
          examAssignmentData(assignmentId).studentIds;
    }
    
    
    
    match /studentTargets/{studentId} {
  function signedInForTarget() {
    return request.auth != null;
  }

  function isTargetStudent() {
    return signedInForTarget() && request.auth.uid == studentId;
  }

  function isTargetAdmin() {
    return signedInForTarget()
      && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
  }

  function teacherOwnsTargetClass(classId) {
    return signedInForTarget()
      && classId is string
      && exists(/databases/$(database)/documents/classes/$(classId))
      && get(/databases/$(database)/documents/classes/$(classId)).data.teacherId == request.auth.uid
      && studentId in get(/databases/$(database)/documents/classes/$(classId)).data.studentIds;
  }

  allow read: if isTargetStudent()
    || isTargetAdmin()
    || (
      resource.data.teacherId == request.auth.uid
      && teacherOwnsTargetClass(resource.data.classId)
    );

  allow create: if isTargetAdmin()
    || (
      request.resource.data.studentId == studentId
      && request.resource.data.teacherId == request.auth.uid
      && teacherOwnsTargetClass(request.resource.data.classId)
    );

  allow update: if isTargetAdmin()
    || (
      resource.data.studentId == studentId
      && request.resource.data.studentId == studentId
      && request.resource.data.teacherId == request.auth.uid
      && teacherOwnsTargetClass(request.resource.data.classId)
    );

  allow delete: if isTargetAdmin()
    || (
      resource.data.teacherId == request.auth.uid
      && teacherOwnsTargetClass(resource.data.classId)
    );
}


    // ------------------------------------------------------------
    // Users
    // ------------------------------------------------------------

  match /users/{userId} {

  allow get: if signedIn() &&
    (
      currentUserId() == userId ||
      isAdmin() ||
      (
        isTeacher() &&
        sameSchoolUser(userId)
      )
    );

  allow list: if signedIn() &&
    (
      isAdmin() ||
      (
        isTeacher() &&
        currentUserHasSchool() &&
        resource.data.schoolId == currentSchoolId()
      )
    );

  /*
   * User profiles are created exclusively by trusted
   * CS Master server code using Firebase Admin.
   */
  allow create: if false;

  /*
   * Self-service profile update.
   *
   * This version is intentionally legacy-safe:
   * old accounts that pre-date schoolId/accountType/personalPlan
   * are interpreted as:
   *
   *   schoolId     = ""
   *   accountType  = "individual"
   *   personalPlan = "free"
   *
   * That lets an authenticated teacher move into a school account
   * only when the matching active school membership exists after
   * the same atomic write.
   */
   /*
 * Legacy approved teacher -> school account migration.
 *
 * Older development teacher accounts can pre-date schoolId,
 * accountType and plan fields. This permits only the one-time
 * transition into an active school membership created in the
 * same atomic batch.
 */
allow update: if signedIn() &&
  currentUserId() == userId &&

  (
    resource.data.role == "teacher" ||
    resource.data.role == "admin"
  ) &&

  request.resource.data.role == resource.data.role &&
  request.resource.data.uid == currentUserId() &&
  request.resource.data.email == resource.data.email &&

  (
    !("schoolId" in resource.data) ||
    resource.data.schoolId == null ||
    resource.data.schoolId == ""
  ) &&

  request.resource.data.schoolId is string &&
  request.resource.data.schoolId != "" &&

  request.resource.data.accountType == "school" &&
  request.resource.data.plan == "school" &&

  /*
   * SECURITY:
   * School migration must not be usable to upgrade the user's
   * personal subscription. Billing-owned personalPlan remains
   * unchanged (legacy missing values resolve to "free").
   */
  userPersonalPlan(request.resource.data) ==
    userPersonalPlan(resource.data) &&

  activeMembershipAfter(
    request.resource.data.schoolId,
    currentUserId()
  ) &&

  request.resource.data
    .diff(resource.data)
    .affectedKeys()
    .hasOnly([
      "uid",
      "schoolId",
      "accountType",
      "plan",
      "personalPlan",
      "updatedAt"
    ]);
    
  allow update: if signedIn() &&
    currentUserId() == userId &&
    request.resource.data.uid == currentUserId() &&
    request.resource.data.email == resource.data.email &&
    (
      (
        "role" in resource.data &&
        request.resource.data.role == resource.data.role
      ) ||
      (
        !("role" in resource.data) &&
        request.resource.data.role == "student"
      )
    ) &&
    (
      !("accountIntent" in request.resource.data) ||
      !("accountIntent" in resource.data) ||
      request.resource.data.accountIntent == resource.data.accountIntent ||
      request.resource.data.accountIntent == "student" ||
      request.resource.data.accountIntent == "teacher"
    ) &&
    (
      !("teacherAccessStatus" in request.resource.data) ||
      !("teacherAccessStatus" in resource.data) ||
      request.resource.data.teacherAccessStatus ==
        resource.data.teacherAccessStatus ||
      request.resource.data.teacherAccessStatus == "not_submitted" ||
      request.resource.data.teacherAccessStatus == "pending"
    ) &&
    validQualification(request.resource.data) &&
    validExamBoard(request.resource.data) &&
    validOnboardingStatus(request.resource.data) &&
    validAccountType(request.resource.data) &&
    validPersonalPlan(request.resource.data) &&
    validEffectivePlan(request.resource.data) &&
    validSchoolIdField(request.resource.data) &&

    /*
     * SECURITY:
     * personalPlan is billing/server controlled.
     *
     * A client must never be able to turn "free" into "premium"
     * by writing its own users/{uid} document. The helper is
     * legacy-safe, so a missing old value is treated as "free".
     */
    userPersonalPlan(request.resource.data) ==
      userPersonalPlan(resource.data) &&

    request.resource.data
      .diff(resource.data)
      .affectedKeys()
      .hasOnly([
        "uid",
        "name",
        "email",
        "role",
        "accountIntent",
        "teacherAccessStatus",
        "accountType",
        "plan",
        "personalPlan",
        "schoolId",
        "currentCourse",
        "qualification",
        "examBoard",
        "onboardingComplete",
        "xp",
        "streak",
        "badges",
        "completedLessons",
        "completedTopics",
        "completedUnits",
        "completedPapers",
        "classIds",
        "updatedAt"
      ]) &&
    (
      /*
       * Normal update while staying in the same tenant/account state.
       */
      (
        userSchoolId(request.resource.data) ==
          userSchoolId(resource.data) &&
        userAccountType(request.resource.data) ==
          userAccountType(resource.data) &&

        /*
         * SECURITY:
         * Normal profile edits cannot change the effective plan.
         * Plan changes are reserved for trusted billing/server flows.
         * The explicit join/leave-school branches below are the only
         * client-side tenant transitions that may change plan between
         * personal and school states.
         */
        userEffectivePlan(request.resource.data) ==
          userEffectivePlan(resource.data)
      ) ||

      /*
       * Join/create a school.
       *
       * The resulting membership must already exist as ACTIVE
       * after this same atomic write.
       */
      (
        userSchoolId(request.resource.data) != "" &&
        userAccountType(request.resource.data) == "school" &&
        userEffectivePlan(request.resource.data) == "school" &&
        activeMembershipAfter(
          userSchoolId(request.resource.data),
          currentUserId()
        )
      ) ||

      /*
       * Leave a school.
       *
       * The previous membership must become FORMER in the
       * same atomic operation.
       */
      (
        userSchoolId(request.resource.data) == "" &&
        userAccountType(request.resource.data) == "individual" &&
        userEffectivePlan(request.resource.data) ==
          userPersonalPlan(request.resource.data) &&
        userSchoolId(resource.data) != "" &&
        existsAfter(
          /databases/$(database)/documents/schools/$(userSchoolId(resource.data))/members/$(currentUserId())
        ) &&
        getAfter(
          /databases/$(database)/documents/schools/$(userSchoolId(resource.data))/members/$(currentUserId())
        ).data.status == "former"
      )
    );


  /*
   * Teacher may only maintain classIds on a student
   * inside the same school.
   */
  allow update: if isTeacher() &&
    resource.data.role == "student" &&
    request.resource.data.role == resource.data.role &&
    (
      isAdmin() ||
      sameSchoolUser(userId)
    ) &&
    request.resource.data
      .diff(resource.data)
      .affectedKeys()
      .hasOnly([
        "classIds",
        "updatedAt"
      ]);

  allow delete: if isAdmin();
}

    // ------------------------------------------------------------
    // Classes
    // ------------------------------------------------------------

    match /classes/{classId} {

      allow get, list: if signedIn() &&
        (
          resource.data.teacherId == currentUserId() ||
          currentUserId() in resource.data.studentIds ||
          isAdmin()
        );

      allow create: if isTeacher() &&
        request.resource.data.teacherId == currentUserId() &&
        request.resource.data.studentIds is list &&
        request.resource.data.assignmentIds is list &&
        (
          isAdmin() ||
          (
            currentUserHasSchool() &&
            request.resource.data.schoolId == currentSchoolId()
          )
        );

      allow update: if isTeacher() &&
        (
          resource.data.teacherId == currentUserId() ||
          isAdmin()
        ) &&
        request.resource.data.teacherId == resource.data.teacherId &&
        (
          isAdmin() ||
          (
            (
              "schoolId" in resource.data &&
              request.resource.data.schoolId == resource.data.schoolId
            ) ||
            (
              !("schoolId" in resource.data) &&
              currentUserHasSchool() &&
              request.resource.data.schoolId == currentSchoolId()
            )
          )
        );

      allow delete: if isTeacher() &&
        (
          resource.data.teacherId == currentUserId() ||
          isAdmin()
        );
    }


    // ------------------------------------------------------------
    // Existing quiz/test assignments
    // ------------------------------------------------------------

    match /assignments/{assignmentId} {

      allow get: if signedIn() &&
  (
    resource.data.teacherId == currentUserId() ||
    currentUserId() in resource.data.get("studentIds", []) ||
    belongsToClass(resource.data.classId) ||
    isAdmin()
  );

allow list: if signedIn() &&
  (
    resource.data.teacherId == currentUserId() ||
    currentUserId() in resource.data.get("studentIds", []) ||
    isAdmin()
  );

      allow create: if isTeacher() &&
        request.resource.data.teacherId == currentUserId() &&
        request.resource.data.classId is string &&
        ownsClass(request.resource.data.classId) &&
        request.resource.data.studentIds is list &&
        request.resource.data.studentIds.size() > 0 &&
        request.resource.data.studentIds.hasOnly(
          get(
            /databases/$(database)/documents/classes/$(request.resource.data.classId)
          ).data.studentIds
        ) &&
        request.resource.data.status == "active";

      allow update: if isTeacher() &&
        (
          resource.data.teacherId == currentUserId() ||
          isAdmin()
        ) &&
        request.resource.data.teacherId == resource.data.teacherId &&
        request.resource.data.classId == resource.data.classId &&
        request.resource.data.type == resource.data.type &&
        request.resource.data.resourceId == resource.data.resourceId &&
        request.resource.data.get("studentIds", []) ==
          resource.data.get("studentIds", []);

      allow delete: if isTeacher() &&
        (
          resource.data.teacherId == currentUserId() ||
          isAdmin()
        );
    }


    // ------------------------------------------------------------
    // Teacher resource class assignments
    // ------------------------------------------------------------

    match /classAssignments/{assignmentId} {

      /*
       * Teachers may read their own assignments.
       * Enrolled students may read assignments containing their UID.
       * Admins may read all assignments.
       */
      allow get, list: if signedIn() &&
        (
          resource.data.teacherId == currentUserId() ||
          currentUserId() in resource.data.studentIds ||
          isAdmin()
        );

      allow create: if isTeacher() &&
        request.resource.data.teacherId == currentUserId() &&
        request.resource.data.classId is string &&
        ownsClass(request.resource.data.classId) &&
        request.resource.data.studentIds is list &&
        request.resource.data.studentIds.size() > 0 &&
        request.resource.data.studentIds.hasOnly(
          get(
            /databases/$(database)/documents/classes/$(request.resource.data.classId)
          ).data.studentIds
        ) &&
        request.resource.data.resourceId is string &&
        request.resource.data.resourceId != "" &&
        request.resource.data.resourceType is string &&
        request.resource.data.status == "active";

      /*
       * Teacher or admin management updates.
       */
      allow update: if isTeacher() &&
        (
          resource.data.teacherId == currentUserId() ||
          isAdmin()
        ) &&
        request.resource.data.teacherId == resource.data.teacherId &&
        request.resource.data.classId == resource.data.classId &&
        request.resource.data.resourceId == resource.data.resourceId &&
        request.resource.data.resourceType == resource.data.resourceType &&
        request.resource.data.studentIds == resource.data.studentIds;

      /*
       * Students may only update the completion counter and timestamp.
       * They cannot edit the resource, class, teacher, due date,
       * instructions or student list.
       */
      allow update: if signedIn() &&
        currentUserId() in resource.data.studentIds &&
        request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasOnly([
            "completedCount",
            "updatedAt"
          ]) &&
        request.resource.data.completedCount is int &&
        request.resource.data.completedCount >=
          resource.data.completedCount &&
        request.resource.data.completedCount <=
          resource.data.studentCount;

      allow delete: if isTeacher() &&
        (
          resource.data.teacherId == currentUserId() ||
          isAdmin()
        );
    }


    // ------------------------------------------------------------
    // Individual student resource progress
    // ------------------------------------------------------------

    match /assignmentProgress/{progressId} {

  /*
   * Students can read their own progress.
   * The teacher who owns the corresponding class assignment
   * can read the student's progress.
   * Admins can read all progress.
   *
   * A missing progress document may still be read directly by
   * its expected student because its document ID follows:
   * assignmentId_studentId
   */
  allow get: if signedIn() &&
    (
      /*
       * Existing progress document.
       */
      (
        resource != null &&
        (
          resource.data.studentId == currentUserId() ||
          isTeacherForClassAssignment(
            resource.data.assignmentId
          ) ||
          isAdmin()
        )
      ) ||

      /*
       * Allows the app to check a student's own missing document.
       */
      progressId.matches(
        "^.*_" + currentUserId() + "$"
      ) ||

      /*
       * A teacher-side analytics loader may directly check an expected
       * progress document before the student has created it. Returning
       * "not found" for a missing document does not expose student data.
       */
      (resource == null && isTeacher())
    );

  allow list: if signedIn() &&
    (
      resource.data.studentId == currentUserId() ||
      isTeacherForClassAssignment(
        resource.data.assignmentId
      ) ||
      isAdmin()
    );

  allow create: if signedIn() &&
    request.resource.data.studentId ==
      currentUserId() &&
    request.resource.data.assignmentId is string &&
    isStudentForClassAssignment(
      request.resource.data.assignmentId
    ) &&
    progressId.matches(
      "^.*_" + currentUserId() + "$"
    ) &&
    request.resource.data.status in [
      "not_started",
      "in_progress",
      "completed"
    ];

  allow update: if signedIn() &&
    resource.data.studentId ==
      currentUserId() &&
    request.resource.data.studentId ==
      resource.data.studentId &&
    request.resource.data.assignmentId ==
      resource.data.assignmentId &&
    isStudentForClassAssignment(
      resource.data.assignmentId
    ) &&
    request.resource.data.status in [
      "not_started",
      "in_progress",
      "completed"
    ] &&
    request.resource.data
      .diff(resource.data)
      .affectedKeys()
      .hasOnly([
        "status",
        "startedAt",
        "completedAt",
        "updatedAt"
      ]);
      
      /*
 * Programming-assignment evidence.
 *
 * Students may save programming evidence only to their own
 * assignmentProgress document, only for a real programming
 * assignment in which they are enrolled.
 *
 * Assignment identity, student identity, class/teacher ownership
 * and assignment configuration cannot be changed here.
 */
allow update: if signedIn() &&

  // This must remain the student's own progress document.
  resource.data.studentId == currentUserId() &&
  request.resource.data.studentId == resource.data.studentId &&
  request.resource.data.assignmentId == resource.data.assignmentId &&

  // The corresponding class assignment must exist.
  exists(
    /databases/$(database)/documents/classAssignments/$(resource.data.assignmentId)
  ) &&

  // It must specifically be a programming assignment.
  get(
    /databases/$(database)/documents/classAssignments/$(resource.data.assignmentId)
  ).data.resourceType == "programming-challenge" &&

  // The signed-in student must actually be enrolled in it.
  currentUserId() in get(
    /databases/$(database)/documents/classAssignments/$(resource.data.assignmentId)
  ).data.studentIds &&

  // The submitted challenge must be the exact challenge assigned.
  request.resource.data.programmingChallengeId ==
    get(
      /databases/$(database)/documents/classAssignments/$(resource.data.assignmentId)
    ).data.resourceId &&

  // Required programming values.
  request.resource.data.programmingCode is string &&
  request.resource.data.programmingAttempts is int &&
  request.resource.data.programmingAttempts >= 1 &&
  request.resource.data.programmingPassedCount is int &&
  request.resource.data.programmingPassedCount >= 0 &&
  request.resource.data.programmingTotalTests is int &&
  request.resource.data.programmingTotalTests >= 0 &&
  request.resource.data.programmingPassedCount <=
    request.resource.data.programmingTotalTests &&
  request.resource.data.programmingPercentage is int &&
  request.resource.data.programmingPercentage >= 0 &&
  request.resource.data.programmingPercentage <= 100 &&
  request.resource.data.programmingLastPassed is bool &&
  request.resource.data.programmingLastError is string &&
  request.resource.data.studentName is string &&

  // An attempt may increase by exactly one.
  (
    (
      !("programmingAttempts" in resource.data) &&
      request.resource.data.programmingAttempts == 1
    ) ||
    (
      "programmingAttempts" in resource.data &&
      request.resource.data.programmingAttempts ==
        resource.data.programmingAttempts + 1
    )
  ) &&

  // Nothing else can be modified by this programming-evidence write.
  request.resource.data
    .diff(resource.data)
    .affectedKeys()
    .hasOnly([
      "studentName",
      "programmingChallengeId",
      "programmingCode",
      "programmingAttempts",
      "programmingPassedCount",
      "programmingTotalTests",
      "programmingPercentage",
      "programmingLastPassed",
      "programmingLastError",
      "updatedAt"
    ]);

  allow delete: if false;
}


    // ------------------------------------------------------------
    // Assignment results
    // ------------------------------------------------------------

    match /assignmentResults/{resultId} {

  /*
   * Students may read their own existing result.
   *
   * The result document ID uses:
   * assignmentId_studentId
   *
   * The suffix check also allows a student to perform a direct
   * get before the result exists. Firestore can then return
   * "document not found" and the app displays "Not started".
   *
   * Teachers may read results belonging to their assignments.
   * Admins may read all results.
   */
  allow get: if signedIn() &&
    (
      (
        resource != null &&
        (
          resource.data.studentId ==
            currentUserId() ||
          resource.data.teacherId ==
            currentUserId() ||
          isAdmin()
        )
      ) ||

      resultId.matches(
        "^.*_" + currentUserId() + "$"
      ) ||

      /*
       * Teacher analytics may check an expected quiz result before it
       * exists. Permit only the missing-document lookup; existing result
       * documents remain protected by teacherId/studentId ownership above.
       */
      (resource == null && isTeacher())
    );

  /*
   * Queries remain restricted to the student, owning teacher
   * or an administrator.
   */
  allow list: if signedIn() &&
    (
      resource.data.studentId ==
        currentUserId() ||
      resource.data.teacherId ==
        currentUserId() ||
      isAdmin()
    );

  /*
   * Students may create only their own completed result.
   * Assignment, class and teacher values must match the
   * original quiz assignment document.
   */
  allow create: if signedIn() &&
    request.resource.data.studentId ==
      currentUserId() &&
    assignmentExists(
      request.resource.data.assignmentId
    ) &&
    request.resource.data.classId ==
      assignmentData(
        request.resource.data.assignmentId
      ).classId &&
    request.resource.data.teacherId ==
      assignmentData(
        request.resource.data.assignmentId
      ).teacherId &&
    request.resource.data.resourceId ==
      assignmentData(
        request.resource.data.assignmentId
      ).resourceId &&
    request.resource.data.assignmentType ==
      "quiz" &&
    belongsToClass(
      request.resource.data.classId
    ) &&
    request.resource.data.status ==
      "completed";

  /*
   * Students may update only their own result while preserving
   * assignment ownership and identity fields.
   */
  allow update: if signedIn() &&
    resource.data.studentId ==
      currentUserId() &&
    request.resource.data.studentId ==
      resource.data.studentId &&
    request.resource.data.assignmentId ==
      resource.data.assignmentId &&
    request.resource.data.classId ==
      resource.data.classId &&
    request.resource.data.teacherId ==
      resource.data.teacherId &&
    request.resource.data.resourceId ==
      resource.data.resourceId &&
    request.resource.data.assignmentType ==
      resource.data.assignmentType &&
    request.resource.data.status ==
      "completed" &&
    request.resource.data
      .diff(resource.data)
      .affectedKeys()
      .hasOnly([
        "score",
        "totalQuestions",
        "percentage",
        "earnedXP",
        "timeTakenSeconds",
        "status",
        "completedAt"
      ]);

  allow delete: if isTeacher() &&
    (
      resource.data.teacherId ==
        currentUserId() ||
      isAdmin()
    );
}


    // ------------------------------------------------------------
    // AI-generated quizzes
    // ------------------------------------------------------------

    match /generatedQuizzes/{quizId} {

      allow create: if isTeacher() &&
        request.resource.data.teacherId ==
          currentUserId();

      allow update: if isTeacher() &&
        (
          resource.data.teacherId ==
            currentUserId() ||
          isAdmin()
        ) &&
        request.resource.data.teacherId ==
          resource.data.teacherId;

      allow delete: if isTeacher() &&
        (
          resource.data.teacherId ==
            currentUserId() ||
          isAdmin()
        );

      allow list: if isTeacher() &&
        (
          resource.data.teacherId == currentUserId() ||
          isAdmin()
        );

      /*
       * Generated quizzes may contain answer keys and explanations.
       * Students receive assigned AI quizzes only through the protected
       * /api/quiz/secure server route, so direct Firestore reads are
       * restricted to the owning teacher or an administrator.
       */
      allow get: if isTeacher() &&
        (
          resource.data.teacherId == currentUserId() ||
          isAdmin()
        );
    }


    // ------------------------------------------------------------
    // Student quiz results
    // users/{userId}/quizResults/{resultId}
    // ------------------------------------------------------------

    match /users/{userId}/quizResults/{resultId} {

      allow get, list: if signedIn() &&
        (
          currentUserId() == userId ||
          isTeacher()
        );

      allow create: if signedIn() &&
        currentUserId() == userId &&
        request.resource.data.uid ==
          currentUserId();

      allow update: if signedIn() &&
        currentUserId() == userId &&
        request.resource.data.uid ==
          resource.data.uid &&
        request.resource.data.uid ==
          currentUserId();

      allow delete: if signedIn() &&
        (
          currentUserId() == userId ||
          isAdmin()
        );
    }


    // Supports collectionGroup(db, "quizResults").
    match /{path=**}/quizResults/{resultId} {
      allow get, list: if isTeacher();
    }


// ------------------------------------------------------------
// Student programming practice evidence
// users/{userId}/programmingPracticeResults/{resultId}
// ------------------------------------------------------------

match /users/{userId}/programmingPracticeResults/{resultId} {

  allow get, list: if signedIn() &&
    (
      currentUserId() == userId ||
      isTeacher()
    );

  allow create: if signedIn() &&
    currentUserId() == userId &&
    request.resource.data.uid ==
      currentUserId();

  allow update: if signedIn() &&
    currentUserId() == userId &&
    request.resource.data.uid ==
      resource.data.uid &&
    request.resource.data.uid ==
      currentUserId();

  allow delete: if signedIn() &&
    (
      currentUserId() == userId ||
      isAdmin()
    );
}

    // ------------------------------------------------------------
    // Teacher access requests
    // ------------------------------------------------------------

    match /teacherRequests/{requestId} {

  /*
   * A signed-in user may submit only a pending teacher request
   * belonging to their own Firebase UID.
   */
  allow create: if signedIn() &&
    request.resource.data.userId == currentUserId() &&
    request.resource.data.status == "pending" &&
    request.resource.data.name is string &&
    request.resource.data.email is string &&
    request.resource.data.schoolName is string &&
    request.resource.data.jobTitle is string &&
    request.resource.data.message is string;

  /*
   * Applicant may open their own request.
   * Admin may open any request.
   */
  allow get: if signedIn() &&
    (
      resource.data.userId == currentUserId() ||
      isAdmin()
    );

  /*
   * Applicants need this because teacherRequestService performs:
   *
   * where("userId", "==", currentUserId())
   *
   * Firestore treats that as a LIST/query operation.
   *
   * Rules still protect other applicants: the query must only
   * return documents whose userId matches the signed-in user.
   */
  allow list: if signedIn() &&
    (
      resource.data.userId == currentUserId() ||
      isAdmin()
    );

  /*
   * Applicants cannot approve, reject or modify requests.
   * Review remains administrator-only.
   */
  allow update, delete: if isAdmin();
}

    // ------------------------------------------------------------
    // Teacher resource library
    // ------------------------------------------------------------

    match /teacherResources/{resourceId} {

      allow create: if isTeacher() &&
        request.resource.data.teacherId ==
          currentUserId();

      /*
       * Teachers may query their own resource library.
       */
      allow list: if isTeacher() &&
        (
          resource.data.teacherId == currentUserId() ||
          isAdmin()
        );

      /*
       * Teachers/admins may open managed resources.
       * Signed-in students may directly open published resources.
       */
      allow get: if signedIn() &&
        (
          resource.data.teacherId ==
            currentUserId() ||
          isAdmin() ||
          resource.data.status == "published"
        );

      allow update: if isTeacher() &&
        (
          resource.data.teacherId ==
            currentUserId() ||
          isAdmin()
        ) &&
        request.resource.data.teacherId ==
          resource.data.teacherId;

      allow delete: if isTeacher() &&
        (
          resource.data.teacherId ==
            currentUserId() ||
          isAdmin()
        );
    }



    // ------------------------------------------------------------
    // Exam-style question sets
    // ------------------------------------------------------------

    match /examQuestionSets/{questionSetId} {

      /*
       * Teachers may create question sets only for themselves.
       */
      allow create: if isTeacher() &&
        request.resource.data.teacherId ==
          currentUserId();

      /*
       * Teachers may read only their own question sets.
       * Admins may read all question sets.
       */
      allow get, list: if isTeacher() &&
        (
          resource.data.teacherId ==
            currentUserId() ||
          isAdmin()
        );

      /*
       * Teachers may update only their own question sets.
       * The teacherId must never be changed.
       */
      allow update: if isTeacher() &&
        (
          resource.data.teacherId ==
            currentUserId() ||
          isAdmin()
        ) &&
        request.resource.data.teacherId ==
          resource.data.teacherId;

      /*
       * Teachers may delete only their own question sets.
       * Admins may delete any question set.
       */
      allow delete: if isTeacher() &&
        (
          resource.data.teacherId ==
            currentUserId() ||
          isAdmin()
        );
    }



    // ------------------------------------------------------------
    // Written exam assignments
    // ------------------------------------------------------------

    match /examAssignments/{assignmentId} {

      allow get, list: if signedIn() &&
        (
          resource.data.teacherId == currentUserId() ||
          currentUserId() in resource.data.studentIds ||
          isAdmin()
        );

      allow create: if isTeacher() &&
        request.resource.data.teacherId == currentUserId() &&
        ownsClass(request.resource.data.classId) &&
        request.resource.data.studentIds is list &&
        request.resource.data.studentIds.size() > 0 &&
        request.resource.data.studentIds.hasOnly(
          get(
            /databases/$(database)/documents/classes/$(request.resource.data.classId)
          ).data.studentIds
        ) &&
        request.resource.data.questionSetSnapshot is map &&
        request.resource.data.status == "active";

      allow update: if isTeacher() &&
        (
          resource.data.teacherId == currentUserId() ||
          isAdmin()
        ) &&
        request.resource.data.teacherId == resource.data.teacherId &&
        request.resource.data.classId == resource.data.classId &&
        request.resource.data.studentIds == resource.data.studentIds;

      allow update: if signedIn() &&
        currentUserId() in resource.data.studentIds &&
        request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasOnly([
            "submittedCount",
            "updatedAt"
          ]) &&
        request.resource.data.submittedCount is int &&
        request.resource.data.submittedCount >=
          resource.data.submittedCount &&
        request.resource.data.submittedCount <=
          resource.data.studentIds.size();

      allow delete: if isTeacher() &&
        (
          resource.data.teacherId == currentUserId() ||
          isAdmin()
        );
    }


    // ------------------------------------------------------------
    // Student written exam submissions
    // ------------------------------------------------------------

    match /examSubmissions/{submissionId} {

      /*
       * Written exam submission document ID:
       * assignmentId_studentId
       *
       * Students can read their own submission.
       * The owning teacher and administrators can also read it.
       */
      allow get: if signedIn() &&
        (
          (
            resource != null &&
            (
              resource.data.studentId == currentUserId() ||
              resource.data.teacherId == currentUserId() ||
              isAdmin()
            )
          ) ||
          submissionId.matches(
            "^.*_" + currentUserId() + "$"
          ) ||
          (resource == null && isTeacher())
        );

      allow list: if signedIn() &&
        (
          resource.data.studentId == currentUserId() ||
          resource.data.teacherId == currentUserId() ||
          isAdmin()
        );

      /*
       * A student may create only their own initial submission for an exam
       * assignment that is actually assigned to them.
       */
      allow create: if signedIn() &&
        request.resource.data.studentId == currentUserId() &&
        submissionId.matches(
          "^.*_" + currentUserId() + "$"
        ) &&
        request.resource.data.assignmentId is string &&
        isStudentForExamAssignment(
          request.resource.data.assignmentId
        ) &&
        request.resource.data.teacherId ==
          examAssignmentData(
            request.resource.data.assignmentId
          ).teacherId &&
        request.resource.data.classId ==
          examAssignmentData(
            request.resource.data.assignmentId
          ).classId &&
        request.resource.data.status == "in_progress" &&
        request.resource.data.answers is list &&
        request.resource.data.totalAvailableMarks is int &&
        request.resource.data.totalAvailableMarks > 0 &&
        request.resource.data.totalAwardedMarks == 0 &&
        request.resource.data.percentage == 0 &&
        request.resource.data.overallFeedback == "" &&
        request.resource.data.integrityIncidents is list &&
        request.resource.data.integrityIncidents.size() == 0 &&
        request.resource.data.integrityTerminated == false &&
        request.resource.data.integrityTerminationReason == "";

      /*
       * Student updates:
       * - autosave answers
       * - normal submission
       * - start integrity monitoring
       * - record fullscreen/page-visibility incidents
       * - track current question
       * - integrity termination + automatic submission
       *
       * Identity and teacher-marking fields remain protected.
       */
      allow update: if signedIn() &&
        resource.data.studentId == currentUserId() &&
        request.resource.data.studentId == resource.data.studentId &&
        request.resource.data.assignmentId == resource.data.assignmentId &&
        request.resource.data.teacherId == resource.data.teacherId &&
        request.resource.data.classId == resource.data.classId &&
        isStudentForExamAssignment(
          resource.data.assignmentId
        ) &&
        request.resource.data.status in [
          "in_progress",
          "submitted"
        ] &&
        request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasOnly([
            "answers",
            "status",
            "submittedAt",
            "updatedAt",
            "integrityPolicySnapshot",
            "integrityIncidents",
            "integrityTerminated",
            "integrityTerminationReason",
            "integritySessionStartedAt",
            "integrityLastQuestionNumber"
          ]);

      /*
       * Teacher/admin marking updates.
       */
      allow update: if isTeacher() &&
        (
          resource.data.teacherId == currentUserId() ||
          isAdmin()
        ) &&
        request.resource.data.studentId == resource.data.studentId &&
        request.resource.data.assignmentId == resource.data.assignmentId &&
        request.resource.data.teacherId == resource.data.teacherId &&
        request.resource.data.classId == resource.data.classId &&
        request.resource.data.status in [
          "marking",
          "marked"
        ] &&
        request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasOnly([
            "answers",
            "overallFeedback",
            "totalAwardedMarks",
            "totalAvailableMarks",
            "percentage",
            "status",
            "markedAt",
            "updatedAt"
          ]);

      allow delete: if isTeacher() &&
        (
          resource.data.teacherId == currentUserId() ||
          isAdmin()
        );
    }


match /interventions/{interventionId} {
  allow create: if isTeacher() &&
    request.resource.data.teacherId == request.auth.uid;

  allow get, list: if signedIn() &&
    (
      resource.data.teacherId == request.auth.uid ||
      resource.data.studentId == request.auth.uid ||
      isAdmin()
    );

  allow update: if signedIn() &&
    (
      (
        resource.data.teacherId == request.auth.uid &&
        request.resource.data.teacherId == resource.data.teacherId &&
        request.resource.data.studentId == resource.data.studentId
      ) ||
      (
        resource.data.studentId == request.auth.uid &&
        request.resource.data.teacherId == resource.data.teacherId &&
        request.resource.data.studentId == resource.data.studentId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "steps", "status", "completedAt", "updatedAt"
        ])
      ) ||
      isAdmin()
    );

  allow delete: if isAdmin() ||
    (isTeacher() && resource.data.teacherId == request.auth.uid);
}


match /studentTutorConversations/{conversationId} {
  allow create: if signedIn() && request.resource.data.studentId == currentUserId();
  allow get, list: if signedIn() && (resource.data.studentId == currentUserId() || isAdmin());
  allow update: if signedIn() &&
    resource.data.studentId == currentUserId() &&
    request.resource.data.studentId == resource.data.studentId &&
    request.resource.data.diff(resource.data).affectedKeys().hasOnly(["title", "messages", "updatedAt"]);
  allow delete: if signedIn() && (resource.data.studentId == currentUserId() || isAdmin());
  
  }



 match /lessonProgress/{progressId} {

  /*
   * Lesson-progress document IDs use:
   * {studentId}_{lessonId}
   */

  allow get: if signedIn() &&
    (
      (
        resource != null &&
        resource.data.studentId == currentUserId()
      ) ||
      progressId.matches(
        "^" + currentUserId() + "_.*$"
      ) ||
      isTeacher() ||
      isAdmin()
    );

  /*
   * Students may query only their own progress.
   * Teachers and administrators may query student progress.
   */
  allow list: if signedIn() &&
    (
      resource.data.studentId == currentUserId() ||
      isTeacher() ||
      isAdmin()
    );

  /*
   * Students may create only their own lesson-progress record.
   */
  allow create: if signedIn() &&
    request.resource.data.studentId == currentUserId() &&
    request.resource.data.lessonId is string &&
    request.resource.data.topicId is string &&
    request.resource.data.currentStepIndex is int &&
    request.resource.data.completedStepIds is list &&
    request.resource.data.practiceResponses is list &&
    request.resource.data.checkpointResponses is list &&
    request.resource.data.status in [
      "in_progress",
      "completed"
    ] &&
    progressId.matches(
      "^" + currentUserId() + "_.*$"
    );

  /*
   * Students may update the interactive state of only their
   * own progress record. Identity fields cannot be changed.
   */
  allow update: if signedIn() &&
    resource.data.studentId == currentUserId() &&
    request.resource.data.studentId ==
      resource.data.studentId &&
    request.resource.data.lessonId ==
      resource.data.lessonId &&
    request.resource.data.topicId ==
      resource.data.topicId &&
    progressId.matches(
      "^" + currentUserId() + "_.*$"
    ) &&
    request.resource.data.status in [
      "in_progress",
      "completed"
    ] &&
    request.resource.data
      .diff(resource.data)
      .affectedKeys()
      .hasOnly([
        "currentStepIndex",
        "completedStepIds",
        "practiceResponses",
        "checkpointResponses",
        "examResponse",
        "examMarking",
        "reflection",
        "audioEnabled",
        "audioRate",
        "selectedVoiceName",
        "practiceAccuracy",
        "checkpointAccuracy",
        "examAccuracy",
        "overallAccuracy",
        "masteryImpact",
        "reviewAt",
        "status",
        "startedAt",
        "updatedAt",
        "completedAt"
      ]);

  allow delete: if signedIn() &&
    (
      resource.data.studentId == currentUserId() ||
      isAdmin()
    );
}

    match /examTrainerAttempts/{attemptId} {
  /*
   * Exam Trainer is student self-practice rather than a teacher-controlled
   * formal examination. Even so, attempt identity and the selected question
   * set must be immutable once the attempt is created.
   */
  allow create: if signedIn() &&
    request.resource.data.studentId == currentUserId() &&
    attemptId.matches("^" + currentUserId() + "_[0-9]+$") &&
    request.resource.data.status == "in_progress" &&
    request.resource.data.report == null &&
    request.resource.data.questions is list &&
    request.resource.data.answers is list &&
    request.resource.data.currentQuestionIndex is int &&
    request.resource.data.durationSeconds is int &&
    request.resource.data.secondsRemaining is int;

  allow get, list: if signedIn() &&
    resource.data.studentId == currentUserId();

  /*
   * Only a live attempt may mutate. Questions, student identity, selected
   * filters, original duration and startedAt are intentionally excluded.
   */
  allow update: if signedIn() &&
    resource.data.studentId == currentUserId() &&
    resource.data.status == "in_progress" &&
    request.resource.data.studentId == resource.data.studentId &&
    request.resource.data.status in [
      "in_progress",
      "submitted",
      "abandoned"
    ] &&
    request.resource.data.currentQuestionIndex is int &&
    request.resource.data.currentQuestionIndex >= 0 &&
    request.resource.data.secondsRemaining is int &&
    request.resource.data.secondsRemaining >= 0 &&
    request.resource.data.secondsRemaining <= resource.data.durationSeconds &&
    request.resource.data
      .diff(resource.data)
      .affectedKeys()
      .hasOnly([
        "answers",
        "currentQuestionIndex",
        "secondsRemaining",
        "status",
        "report",
        "submittedAt",
        "updatedAt"
      ]) &&
    (
      (
        request.resource.data.status == "in_progress" &&
        request.resource.data.report == resource.data.report &&
        request.resource.data.submittedAt == resource.data.submittedAt
      ) ||
      (
        request.resource.data.status == "abandoned" &&
        request.resource.data.report == resource.data.report &&
        request.resource.data.submittedAt == resource.data.submittedAt
      ) ||
      (
        request.resource.data.status == "submitted" &&
        request.resource.data.report is map
      )
    );

  allow delete: if false;
}


match /users/{userId}/examTrainerResults/{resultId} {
  allow read: if signedIn() &&
    currentUserId() == userId;

  /*
   * A summary must correspond to the student's submitted Exam Trainer attempt.
   * These records remain self-practice evidence and are not formal grades.
   */
  allow create, update: if signedIn() &&
    currentUserId() == userId &&
    resultId.matches("^" + userId + "_[0-9]+$") &&
    exists(
      /databases/$(database)/documents/examTrainerAttempts/$(resultId)
    ) &&
    get(
      /databases/$(database)/documents/examTrainerAttempts/$(resultId)
    ).data.studentId == userId &&
    get(
      /databases/$(database)/documents/examTrainerAttempts/$(resultId)
    ).data.status == "submitted";

  allow delete: if false;
}

    // ------------------------------------------------------------
    // Schools / organisations
    // ------------------------------------------------------------

    match /schools/{schoolId} {

      allow create: if isTeacher() &&
        request.resource.data.name is string &&
        request.resource.data.slug is string &&
        request.resource.data.status == "active" &&
        request.resource.data.ownerUserId == currentUserId() &&
        existsAfter(
          /databases/$(database)/documents/schools/$(schoolId)/members/$(currentUserId())
        ) &&
        getAfter(
          /databases/$(database)/documents/schools/$(schoolId)/members/$(currentUserId())
        ).data.role == "school_admin" &&
        getAfter(
          /databases/$(database)/documents/schools/$(schoolId)/members/$(currentUserId())
        ).data.status == "active" &&
        getAfter(
          /databases/$(database)/documents/users/$(currentUserId())
        ).data.schoolId == schoolId;

      allow get, list: if signedIn() &&
        (
          isAdmin() ||
          isSchoolMember(schoolId)
        );

      allow update: if isSchoolAdmin(schoolId) &&
        request.resource.data.ownerUserId == resource.data.ownerUserId &&
        request.resource.data.slug == resource.data.slug;

      allow delete: if isAdmin();

      match /members/{memberId} {

        allow get, list: if signedIn() &&
          (
            isAdmin() ||
            isSchoolMember(schoolId)
          );

        allow create: if signedIn() &&
          memberId == currentUserId() &&
          request.resource.data.userId == currentUserId() &&
          request.resource.data.schoolId == schoolId &&
          request.resource.data.role == "school_admin" &&
          request.resource.data.status == "active" &&
          existsAfter(
            /databases/$(database)/documents/schools/$(schoolId)
          ) &&
          getAfter(
            /databases/$(database)/documents/schools/$(schoolId)
          ).data.ownerUserId == currentUserId();

        allow create: if signedIn() &&
          memberId == currentUserId() &&
          request.resource.data.userId == currentUserId() &&
          request.resource.data.schoolId == schoolId &&
          request.resource.data.status == "active" &&
          request.resource.data.role in [
            "student",
            "teacher"
          ] &&
          request.resource.data.inviteId is string &&
          exists(
            /databases/$(database)/documents/schoolInvites/$(request.resource.data.inviteId)
          ) &&
          get(
            /databases/$(database)/documents/schoolInvites/$(request.resource.data.inviteId)
          ).data.schoolId == schoolId &&
          get(
            /databases/$(database)/documents/schoolInvites/$(request.resource.data.inviteId)
          ).data.role == request.resource.data.role &&
          get(
            /databases/$(database)/documents/schoolInvites/$(request.resource.data.inviteId)
          ).data.status == "active" &&
          getAfter(
            /databases/$(database)/documents/schoolInvites/$(request.resource.data.inviteId)
          ).data.status == "used" &&
          getAfter(
            /databases/$(database)/documents/schoolInvites/$(request.resource.data.inviteId)
          ).data.usedBy == currentUserId();

        allow create: if isSchoolAdmin(schoolId) &&
          request.resource.data.schoolId == schoolId &&
          request.resource.data.userId == memberId &&
          request.resource.data.status == "active" &&
          request.resource.data.role in [
            "student",
            "teacher",
            "school_admin"
          ];

        allow update: if isSchoolAdmin(schoolId) &&
          request.resource.data.schoolId == resource.data.schoolId &&
          request.resource.data.userId == resource.data.userId;

        allow update: if signedIn() &&
          memberId == currentUserId() &&
          resource.data.userId == currentUserId() &&
          request.resource.data.userId == resource.data.userId &&
          request.resource.data.schoolId == resource.data.schoolId &&
          request.resource.data.role == resource.data.role &&
          resource.data.status == "active" &&
          request.resource.data.status == "former";

        allow delete: if isAdmin();
      }

      match /settings/{settingId} {
        allow get, list: if isSchoolMember(schoolId);
        allow create, update: if isSchoolAdmin(schoolId);
        allow delete: if isAdmin();
      }

      match /auditLogs/{logId} {
        allow get, list: if isSchoolAdmin(schoolId);
        allow create, update, delete: if false;
      }
    }


    // ------------------------------------------------------------
    // School invitations / join codes
    // ------------------------------------------------------------

    match /schoolInvites/{inviteId} {

      allow create: if isSchoolStaff(request.resource.data.schoolId) &&
        request.resource.data.code == inviteId &&
        request.resource.data.schoolId is string &&
        request.resource.data.createdBy == currentUserId() &&
        request.resource.data.status == "active" &&
        request.resource.data.usedBy == "" &&
        request.resource.data.role in [
          "student",
          "teacher"
        ] &&
        (
          request.resource.data.role == "student" ||
          isSchoolAdmin(request.resource.data.schoolId)
        );

      allow get: if signedIn() &&
        (
          isAdmin() ||
          isSchoolStaff(resource.data.schoolId) ||
          resource.data.status == "active"
        );

      allow list: if false;

      allow update: if signedIn() &&
        resource.data.status == "active" &&
        request.resource.data.status == "used" &&
        request.resource.data.usedBy == currentUserId() &&
        request.resource.data.code == resource.data.code &&
        request.resource.data.schoolId == resource.data.schoolId &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.createdBy == resource.data.createdBy &&
        request.resource.data.expiresAt == resource.data.expiresAt &&
        existsAfter(
          /databases/$(database)/documents/schools/$(resource.data.schoolId)/members/$(currentUserId())
        ) &&
        getAfter(
          /databases/$(database)/documents/schools/$(resource.data.schoolId)/members/$(currentUserId())
        ).data.inviteId == inviteId &&
        getAfter(
          /databases/$(database)/documents/users/$(currentUserId())
        ).data.schoolId == resource.data.schoolId;

      allow update: if isSchoolAdmin(resource.data.schoolId) &&
        resource.data.status == "active" &&
        request.resource.data.status == "revoked" &&
        request.resource.data.code == resource.data.code &&
        request.resource.data.schoolId == resource.data.schoolId &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.createdBy == resource.data.createdBy &&
        request.resource.data.expiresAt == resource.data.expiresAt &&
        request.resource.data.usedBy == resource.data.usedBy;

      allow delete: if isAdmin();
    }


    // ------------------------------------------------------------
    // School transfer requests - future phase
    // ------------------------------------------------------------

    match /schoolTransferRequests/{transferId} {

      allow create: if signedIn() &&
        request.resource.data.studentId == currentUserId() &&
        request.resource.data.toSchoolId is string &&
        request.resource.data.toSchoolId != "" &&
        request.resource.data.status == "pending" &&
        schoolExists(request.resource.data.toSchoolId);

      allow get, list: if signedIn() &&
        (
          isAdmin() ||
          resource.data.studentId == currentUserId() ||
          isSchoolAdmin(resource.data.fromSchoolId) ||
          isSchoolAdmin(resource.data.toSchoolId)
        );

      allow update: if signedIn() &&
        (
          isAdmin() ||
          isSchoolAdmin(resource.data.toSchoolId) ||
          isSchoolAdmin(resource.data.fromSchoolId)
        ) &&
        request.resource.data.studentId == resource.data.studentId &&
        request.resource.data.fromSchoolId == resource.data.fromSchoolId &&
        request.resource.data.toSchoolId == resource.data.toSchoolId &&
        request.resource.data.status in [
          "pending",
          "approved",
          "rejected",
          "cancelled",
          "completed"
        ];

      allow delete: if isAdmin();
    }


    // ------------------------------------------------------------
    // Generated reports - future reporting phase
    // ------------------------------------------------------------

    match /generatedReports/{reportId} {

      allow create: if isTeacher() &&
        currentUserHasSchool() &&
        request.resource.data.teacherId == currentUserId() &&
        request.resource.data.schoolId == currentSchoolId();

      allow get, list: if signedIn() &&
        (
          isAdmin() ||
          (
            currentUserHasSchool() &&
            isSchoolStaff(resource.data.schoolId) &&
            resource.data.schoolId == currentSchoolId()
          ) ||
          resource.data.studentId == currentUserId()
        );

      allow update, delete: if isAdmin() ||
        (
          isTeacher() &&
          currentUserHasSchool() &&
          resource.data.teacherId == currentUserId() &&
          resource.data.schoolId == currentSchoolId()
        );
    }


    // ------------------------------------------------------------
    // User notifications - future alerts phase
    // ------------------------------------------------------------

    match /users/{userId}/notifications/{notificationId} {
      allow get, list: if signedIn() &&
        currentUserId() == userId;

      allow create, delete: if false;

      allow update: if signedIn() &&
        currentUserId() == userId &&
        request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasOnly([
            "read",
            "readAt",
            "updatedAt"
          ]);
    }


    // ------------------------------------------------------------
    // Licensing / subscriptions / billing
    // Future Free -> Premium -> School phase
    // ------------------------------------------------------------

    match /subscriptions/{userId} {
      allow get: if signedIn() &&
        (
          currentUserId() == userId ||
          isAdmin()
        );

      allow list: if isAdmin();

      allow create, update, delete: if false;
    }

    match /schoolLicences/{schoolId} {
      allow get: if signedIn() &&
        (
          isAdmin() ||
          isSchoolAdmin(schoolId)
        );

      allow list: if isAdmin();

      allow create, update, delete: if false;
    }

    match /billingEvents/{eventId} {
      allow get, list: if isAdmin();
      allow create, update, delete: if false;
    }


    // ------------------------------------------------------------
    // Deny collections not explicitly listed
    // ------------------------------------------------------------

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

